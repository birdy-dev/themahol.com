---
import SiteLayout from "../layouts/site_layout.astro";
export const prerender = true;
---

<SiteLayout
  title="Music Sessions | Mahol School of Arts"
  description="Learn, play, and experience live music with Mahol in Edmonton."
>
  <section class="max-w-screen-lg mx-auto px-8 py-24">
    <h1 class="font-title uppercase text-5xl md:text-7xl font-semibold">Music Sessions</h1>
    <p class="mt-8 text-xl leading-8">Learn, play, and experience live music.</p>
    <p class="mt-6 leading-7 text-neutral-300">
      Live music jams and private music lessons. More details are coming soon.
    </p>
    <a
      class="mt-10 inline-flex rounded-lg bg-white px-6 py-3 font-semibold text-black hover:bg-neutral-200"
      href="/contact/"
    >
      Enquire about music
    </a>
  </section>
</SiteLayout>
